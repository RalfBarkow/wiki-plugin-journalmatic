# .envrc
# Local Test Farm quickstart (copy/paste in a shell):
#   mkdir -p ~/workspace/wiki
#   cd ~/workspace/wiki
#   npm i wiki --install-strategy=shallow
#   cd ~/workspace/wiki/node_modules/wiki
#   node --trace-deprecation index.js --config ~/.wiki/config.json.safe --port 80
#
# Install your plugin into the test wiki:
#   cd ~/workspace/wiki/node_modules/wiki
#   npm i $(npm pack /path/to/wiki-plugin-journalmatic | tail -1)
#
# Replace paths/ports as needed.
use flake .
use flake "path:$HOME/flakes/repomix-tools"   # <-- use $HOME or an absolute path
# or simply:
# use flake "$HOME/flakes/repomix-tools"
